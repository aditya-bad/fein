+class TestV16MeanMedianAndShape(unittest.TestCase):
+    """Proposed v1.6 (decision:card-audit-fixes-prereg-2026-11-25 fixes 1 and 5)."""
+
+    def test_dist_mean_lognormal(self):
+        # 5-point Gauss-Hermite mean of a lognormal with median 1 is ~exp(sigma^2/2)
+        sc = {"scenarios": [{"name": "base", "prob": 1.0, "mult5": 1.0}], "blowup": {"prob": 0.0, "multiple": 0.1}}
+        outs = [(p, m) for p, m, _ in dc._outcomes_tagged(sc, 0.35)]
+        self.assertAlmostEqual(dc.dist_mean(outs), math.exp(0.35 ** 2 / 2), places=3)
+        self.assertIsNone(dc.dist_mean([]))
+
+    def test_gate_uses_distribution_mean(self):
+        F, recs, wres = TestBuildIntegration()._build(lambda c: None)
+        dec = recs[-1]["data"]
+        sig = wres["input"]["dispersion"]
+        # unanchored distribution mean exceeds the worksheet's sum(p*mult5) (blow-up is a point, so less than exp(s^2/2))
+        self.assertGreater(dec["ev_mult5_dist_raw"], dec["ev_mult5_raw"])
+        self.assertLess(dec["ev_mult5_dist_raw"], dec["ev_mult5_raw"] * math.exp(sig ** 2 / 2) + 1e-9)
+        self.assertIn("EV convention (v1.6)", F["expected_value"])
+        self.assertIn("v1.6", dec["ev_convention"])
+
+    def test_gate_ev_matches_kelly_outcomes(self):
+        F, recs, wres = TestBuildIntegration()._build(lambda c: None)
+        dec = recs[-1]["data"]
+        sc = wres["scenarios"]
+        touts = dc._outcomes_tagged(sc, wres["input"]["dispersion"])
+        if dec["anchor_weight"] is not None:
+            outs, _ = dc.anchor_outcomes(touts, dec["p_blowup_anchored"] if dec["p_blowup_anchored"] is not None
+                                         else sc["p_blowup"], dec["p_le_half_anchored"] if dec["p_le_half_anchored"]
+                                         is not None else sc["p_le_half"])
+        else:
+            outs = [(p, m) for p, m, _ in touts]
+        self.assertAlmostEqual(dec["ev_mult5_anchored"], dc.dist_mean(outs), places=9)
+
