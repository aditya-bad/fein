+def dist_mean(outcomes):
+    """v1.6 fix (1): mean multiple of an outcome list [(prob, multiple)], i.e. the EV with mult5 read as a median."""
+    if not outcomes:
+        return None
+    tot = sum(p for p, _ in outcomes)
+    return sum(p * m for p, m in outcomes) / tot if tot > 0 else None
+
+
+def scenario_shape_warning(sc):
+    """v1.6 fix (5): text when P(bear) > P(bull) AND the probability-weighted scenario multiple (blow-up excluded)
+    is below the base case; else None. Needs scenarios named 'bear', 'base' and 'bull' with mult5."""
+    by = dict((r.get("name"), r) for r in (sc or {}).get("scenarios") or [])
+    if not all(k in by and by[k].get("mult5") for k in ("bear", "base", "bull")):
+        return None
+    pb, pu = by["bear"]["prob"], by["bull"]["prob"]
+    rows = [r for r in sc["scenarios"] if r.get("mult5")]
+    w = sum(r["prob"] for r in rows)
+    mean = sum(r["prob"] * r["mult5"] for r in rows) / w if w > 0 else None
+    base = by["base"]["mult5"]
+    if pb > pu + 1e-12 and mean is not None and mean < base - 1e-12:
+        return ("%s (bear %.0f%% vs bull %.0f%%; scenario mean %.2fx vs base %.2fx). Real 5-yr outcomes are "
+                "right-skewed (base_rates_5y); say why the downside deserves the larger weight."
+                % (SHAPE_WARNING, 100 * pb, 100 * pu, mean, base))
+    return None
+
