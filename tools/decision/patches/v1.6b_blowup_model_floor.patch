+def blowup_model_p(cls_name, surv, size=None, units=None):
+    """v1.6 blow-up model (blowup_model_test.md). Returns (p, fired flags) or (None, None) when the class has no model.
+    Flags from the card's survival block: B25 = pledge > 25% of promoter holding; S2 = interest cover < 1.5x (not for
+    lenders); BOTH = B25 and S2; S15 (India) = survival.s1 or survival.s5 (negative net worth / >=2 of S1, S2, S4);
+    S1, S5 (US) = survival.s1, survival.s5; SMALL = size below the class's lower-third cut (units must match)."""
+    m = BLOWUP_MODEL.get(cls_name or "")
+    if not m:
+        return None, None
+    surv = surv or {}
+    pl, icr = surv.get("pledge_pct_of_promoter"), surv.get("interest_cover")
+    fin = bool(surv.get("is_financial"))
+    x = {"B25": pl is not None and pl > SURVIVAL_PLEDGE,
+         "S2": (not fin) and icr is not None and icr < SURVIVAL_ICR,
+         "S1": bool(surv.get("s1")), "S5": bool(surv.get("s5")),
+         "SMALL": m["small_cut"] is not None and size is not None and units == m["units"] and size < m["small_cut"]}
+    x["BOTH"] = x["B25"] and x["S2"]
+    x["S15"] = x["S1"] or x["S5"]
+    z = m["const"] + sum(b for k, b in m["coef"].items() if x[k])
+    p = 1 / (1 + math.exp(-z))
+    return min(max(p, BLOWUP_MODEL_CLIP[0]), BLOWUP_MODEL_CLIP[1]), sorted(k for k in m["coef"] if x[k])
+
