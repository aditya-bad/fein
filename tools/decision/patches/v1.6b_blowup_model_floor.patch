+class TestBlowupModel(unittest.TestCase):
+    """v1.6 blow-up model floor (research_notes/Decision audits/blowup_model_test.md)."""
+    IN = "india_nonfin_1000_20000cr_5y"
+
+    def test_no_flags_india(self):
+        p, fl = dc.blowup_model_p(self.IN, {"pledge_pct_of_promoter": 0.0, "interest_cover": 5.0})
+        self.assertAlmostEqual(p, 1 / (1 + math.exp(1.876)), places=6)
+        self.assertEqual(fl, [])
+
+    def test_both_flags_india(self):
+        p, fl = dc.blowup_model_p(self.IN, {"pledge_pct_of_promoter": 0.40, "interest_cover": 1.2})
+        z = -1.876 + 0.460 + 0.387 + 0.759
+        self.assertAlmostEqual(p, 1 / (1 + math.exp(-z)), places=6)
+        self.assertEqual(fl, ["B25", "BOTH", "S2"])
+
+    def test_unknown_flags_count_as_clear(self):
+        self.assertEqual(dc.blowup_model_p(self.IN, {})[0], dc.blowup_model_p(self.IN, {"interest_cover": 9})[0])
+
+    def test_lender_ignores_icr_uses_size(self):
+        c = "india_lender_1000_20000cr_5y"
+        big, _ = dc.blowup_model_p(c, {"is_financial": True, "interest_cover": 0.5}, 5000, "INR cr")
+        small, fl = dc.blowup_model_p(c, {"is_financial": True}, 2000, "INR cr")
+        self.assertAlmostEqual(big, 1 / (1 + math.exp(1.205)), places=6)
+        self.assertGreater(small, big)
+        self.assertEqual(fl, ["SMALL"])
+        self.assertEqual(dc.blowup_model_p(c, {}, 2000, "USD M")[0], big)   # units mismatch -> SMALL not fired
+
+    def test_clip_and_unknown_class(self):
+        p, _ = dc.blowup_model_p("us_float_500m_10b_5y", {"s1": 1, "s5": 1, "interest_cover": 0.1}, 600, "USD M")
+        self.assertLessEqual(p, dc.BLOWUP_MODEL_CLIP[1])
+        self.assertEqual(dc.blowup_model_p("india_survivors_2020_25_all_deprecated", {}), (None, None))
+
+    def test_build_floor_never_lowers_and_is_reported(self):
+        card = dc._load_json(SYN_CARD)
+        card = copy.deepcopy(card)
+        card["base_rate_class"] = self.IN
+        card.setdefault("survival", {})
+        card["survival"].update({"pledge_pct_of_promoter": 0.5, "interest_cover": 1.0})
+        F, recs, _ = dc.build(card, SYN_CARD)
+        self.assertIn("Blow-up model floor", F["probabilities"])
+        self.assertIn("B25, BOTH, S2", F["probabilities"])
+        dec = [r for r in recs if (r.get("data") or {}).get("p_blowup_model") is not None]
+        self.assertTrue(dec)
+        d = dec[0]["data"]
+        self.assertGreaterEqual(d["p_blowup_anchored"], d["p_blowup_model"] - 1e-12)
